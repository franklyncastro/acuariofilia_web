# Copia este archivo a ".env" y completa con los datos de tu proyecto Supabase
# (Project Settings -> API en supabase.com)

VITE_SUPABASE_URL=https://tu-proyecto.supabase.co
VITE_SUPABASE_ANON_KEY=tu-anon-key-publica

# Numero de WhatsApp de la tienda, formato internacional sin "+" ni espacios
# Ejemplo Republica Dominicana: 18095551234
VITE_WHATSAPP_NUMBER=18095551234
